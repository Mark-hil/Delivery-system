# SwiftSend Frontend Environment Variables (Public Client URLs only — all secret keys reside on the backend server)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000/dispatch
# Public Google Maps JavaScript SDK Key (HTTP Referrer restricted in Google Cloud Console; falls back to OpenStreetMap if blank)
VITE_GOOGLE_MAPS_API_KEY=
