# Server & Environment
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (Docker Compose & Prisma)
POSTGRES_USER=swiftsend
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=swiftsend_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://swiftsend:replace_with_postgres_password@localhost:5432/swiftsend_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=replace_with_32_byte_random_hex_access_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_32_byte_random_hex_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 / R2 Cloud Uploads (Leave blank to use local dev mock URLs)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_URL_EXPIRES_SECONDS=300

# Arkesel SMS Gateway
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=SwiftSend
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
ARKESEL_SANDBOX=true

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/customer/wallet
PAYSTACK_MOCK=true

# Database Seed Defaults
SEED_DEFAULT_PASSWORD=replace_with_seed_user_password
SEED_ADMIN_EMAIL=admin@swiftsend.app
SEED_ADMIN_PASSWORD=replace_with_seed_admin_password
